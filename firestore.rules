rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'activeCourseId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'photoURL', 'activeCourseId', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.activeCourseId is string && data.activeCourseId.size() >= 1 && data.activeCourseId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseProgress(data, userId, courseId) {
      return data.keys().hasAll([
          'ownerId', 'courseId', 'selectedDays', 'completedDays',
          'exerciseState', 'vocabMastery', 'starredVocabIds',
          'dayQuizResults', 'matchBestTimeMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'courseId', 'selectedDays', 'completedDays',
          'exerciseState', 'vocabMastery', 'starredVocabIds',
          'dayQuizResults', 'matchBestTimeMs', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.courseId is string && data.courseId == courseId && isValidId(data.courseId)
        && data.selectedDays is int && data.selectedDays >= 1 && data.selectedDays <= 180
        && data.completedDays is list && data.completedDays.size() <= 180
        && (data.completedDays.size() == 0 || data.completedDays[0] is int)
        && data.exerciseState is map && data.exerciseState.size() <= 1000
        && data.vocabMastery is map && data.vocabMastery.size() <= 3000
        && data.starredVocabIds is list && data.starredVocabIds.size() <= 2000
        && (data.starredVocabIds.size() == 0 || data.starredVocabIds[0] is string)
        && data.dayQuizResults is map && data.dayQuizResults.size() <= 365
        && data.matchBestTimeMs is map && data.matchBestTimeMs.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidImportedCourse(data, userId, courseId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'title', 'subtitle', 'level',
          'defaultDays', 'units', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'title', 'subtitle', 'level',
          'sourceFileName', 'defaultDays', 'units', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == courseId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 500
        && data.level is string && data.level.size() >= 1 && data.level.size() <= 80
        && (!('sourceFileName' in data) || (data.sourceFileName is string && data.sourceFileName.size() <= 200))
        && data.defaultDays is int && data.defaultDays >= 1 && data.defaultDays <= 180
        && data.units is list && data.units.size() >= 1 && data.units.size() <= 100
        && data.units[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'activeCourseId', 'updatedAt'
        ]);
      allow delete: if false;

      match /courseProgress/{courseId} {
        allow get: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && isValidCourseProgress(incoming(), userId, courseId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && isValidCourseProgress(incoming(), userId, courseId)
          && incoming().ownerId == existing().ownerId
          && incoming().courseId == existing().courseId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'selectedDays', 'completedDays', 'exerciseState',
            'vocabMastery', 'starredVocabIds', 'dayQuizResults',
            'matchBestTimeMs', 'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }

      match /courses/{courseId} {
        allow get: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && isValidImportedCourse(incoming(), userId, courseId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && isValidImportedCourse(incoming(), userId, courseId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subtitle', 'level', 'defaultDays', 'units', 'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidId(courseId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
